{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gprocess",
  "version": "0.1.0",
  "identifier": "com.gprocess.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gprocess",
        "width": 1360,
        "height": 840,
        "minWidth": 1180,
        "minHeight": 700
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5QjA5NkMwRDU4QTJBRDIKUldUU0tvclZ3SmF3NlJoSkZmSlFaM2R2NzNDNEF0ZmhyU3hqOUhPeXdVbnZPeXZtZjdrZXRycGQK",
      "endpoints": [
        "https://github.com/watertreestar/gprocess/releases/latest/download/latest.json"
      ]
    }
  }
}
